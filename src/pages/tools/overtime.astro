---
import CalculatorLayout from '../../layouts/CalculatorLayout.astro';
import { MIN_WAGE, OVERTIME } from '../../config/tw.ts';

const faq = [
  {
    q: '加班費的時薪怎麼算？',
    a: '勞動部認定月薪制勞工的「平日每小時工資額」= 月薪 ÷ 30 ÷ 8。月薪 36,000 元，時薪就是 150 元。注意：月薪要含經常性給與（例如全勤、固定津貼），不能只用底薪。',
  },
  {
    q: '平日加班費怎麼算？',
    a: '依勞基法第 24 條，平日延長工時前 2 小時每小時加給三分之一以上（實務以 1.34 倍計，1.33 會違法），第 3、4 小時加給三分之二以上（1.67 倍）。每天正常工時加延長工時不得超過 12 小時。',
  },
  {
    q: '休息日加班費怎麼算？',
    a: '休息日出勤前 2 小時 1.34 倍、第 3–8 小時 1.67 倍、第 9–12 小時 2.67 倍，且 2018 年修法後依實際出勤時數核實計算（不再「做 1 給 4」）。休息日工時計入每月 46 小時延長工時上限。',
  },
  {
    q: '國定假日上班薪水怎麼算？',
    a: '依勞基法第 39 條，國定假日或特休日出勤「加倍發給」：原本當日工資照給，再加發一日工資（8 小時工資）。即使只上 3 小時，也要加發一整天；超過 8 小時的部分再依平日延長工時倍率計算。',
  },
  {
    q: '每月加班時數上限是多少？',
    a: '原則每月 46 小時；經工會或勞資會議同意可調整為每月 54 小時、每 3 個月不超過 138 小時。',
  },
];

const sources = [
  { name: '勞動部｜加班費試算系統', href: 'https://calcr2.mol.gov.tw/Index' },
  { name: '全國法規資料庫｜勞動基準法第 24、32、39 條', href: 'https://law.moj.gov.tw/LawClass/LawAll.aspx?pcode=N0030001' },
  { name: `勞動部｜${MIN_WAGE.year} 年基本工資公告`, href: 'https://www.mol.gov.tw/' },
];
---

<CalculatorLayout slug="overtime" faq={faq} updated="2026-11-08" sources={sources}>
  <section class="card">
    <form id="calc" class="form-grid" novalidate>
      <div class="field">
        <label for="salary">月薪（含經常性津貼）</label>
        <div class="input-wrap">
          <input id="salary" name="salary" type="number" inputmode="numeric" min="0" step="1000" value="36000" />
          <span class="suffix">元</span>
        </div>
        <span class="hint">{MIN_WAGE.year} 年基本工資 {MIN_WAGE.monthly.toLocaleString()} 元；時薪 = 月薪 ÷ 240</span>
      </div>
      <div class="field">
        <label for="weekday">平日加班（單日）</label>
        <div class="input-wrap">
          <input id="weekday" name="weekday" type="number" inputmode="decimal" min="0" max="4" step="0.5" value="2" />
          <span class="suffix">小時</span>
        </div>
        <span class="hint">單日最多 4 小時</span>
      </div>
      <div class="field">
        <label for="rest">休息日出勤（單日）</label>
        <div class="input-wrap">
          <input id="rest" name="rest" type="number" inputmode="decimal" min="0" max="12" step="0.5" value="8" />
          <span class="suffix">小時</span>
        </div>
        <span class="hint">單日最多 12 小時</span>
      </div>
      <div class="field">
        <label for="holiday">國定假日／特休出勤（單日）</label>
        <div class="input-wrap">
          <input id="holiday" name="holiday" type="number" inputmode="decimal" min="0" max="12" step="0.5" value="0" />
          <span class="suffix">小時</span>
        </div>
        <span class="hint">8 小時內一律加發 1 日工資</span>
      </div>
      <div class="field">
        <label for="days">本月各類加班天數（估算月總額用）</label>
        <div class="input-wrap">
          <input id="days" name="days" type="number" inputmode="numeric" min="1" max="31" step="1" value="1" />
          <span class="suffix">天</span>
        </div>
        <span class="hint">以上三種各乘以此天數</span>
      </div>
    </form>

    <div id="results" aria-live="polite" style="margin-top:1.25rem"></div>
    <div style="display:flex;gap:.5rem;flex-wrap:wrap;margin-top:1rem">
      <button type="button" class="btn btn-ghost btn-sm" id="share">複製試算連結</button>
    </div>
  </section>

  <Fragment slot="article">
    <h2>加班費倍率速查表</h2>
    <div class="table-wrap">
      <table>
        <thead><tr><th>出勤類型</th><th>時段</th><th>倍率</th><th>法源</th></tr></thead>
        <tbody>
          <tr><td>平日延長工時</td><td>前 2 小時</td><td>×1.34</td><td>勞基法 §24 I-1</td></tr>
          <tr><td>平日延長工時</td><td>第 3–4 小時</td><td>×1.67</td><td>勞基法 §24 I-2</td></tr>
          <tr><td>休息日</td><td>前 2 小時</td><td>×1.34</td><td>勞基法 §24 II</td></tr>
          <tr><td>休息日</td><td>第 3–8 小時</td><td>×1.67</td><td>勞基法 §24 II</td></tr>
          <tr><td>休息日</td><td>第 9–12 小時</td><td>×2.67</td><td>勞基法 §24 II</td></tr>
          <tr><td>國定假日／特休</td><td>8 小時內</td><td>加發 1 日工資</td><td>勞基法 §39</td></tr>
          <tr><td>國定假日／特休</td><td>第 9–10 ／ 11–12 小時</td><td>×1.34 ／ ×1.67</td><td>勞基法 §24 I</td></tr>
          <tr><td>例假日</td><td>僅天災事變可出勤</td><td>加倍發給＋補假</td><td>勞基法 §40</td></tr>
        </tbody>
      </table>
    </div>
    <h2>範例：月薪 36,000 元</h2>
    <p>
      時薪 = 36,000 ÷ 240 = 150 元。平日加班 3 小時 = 150 × 1.34 × 2 ＋ 150 × 1.67 × 1 = 402 ＋ 250.5 ≈ 653 元。
      休息日出勤 8 小時 = 150 × 1.34 × 2 ＋ 150 × 1.67 × 6 = 402 ＋ 1,503 = 1,905 元。
      國定假日出勤 8 小時 = 加發 1 日工資 1,200 元。
    </p>
    <h2>常見的違法算法</h2>
    <ul>
      <li>用「底薪」而不是「月薪總額」算時薪（全勤、職務加給等經常性給與都要算進去）。</li>
      <li>平日加班以 1.33 倍計（法定是三分之一以上，1.333…，四捨五入到 1.34 才合法）。</li>
      <li>休息日出勤只給「補休」卻不讓勞工選擇領加班費（補休須勞工同意，且期限內未休完要折現）。</li>
      <li>國定假日出勤只給實際小時數工資。</li>
    </ul>
    <h2>人資多人試算</h2>
    <p>
      勞動部官方試算系統一次只能算 1 人 1 週。若你需要整間公司多人、多週的批次計算與匯出，歡迎 <a href="/contact">聯絡我們</a> 了解批次版本。
    </p>
    <p class="muted">每月延長工時上限 {OVERTIME.monthlyCap} 小時；每日工時上限 {OVERTIME.dailyCap} 小時。</p>
  </Fragment>
</CalculatorLayout>

<script>
  import { overtimePay } from '../../lib/finance.ts';
  import { money, num, readNumber } from '../../lib/format.ts';
  import { bindCalculator, setupShareButton } from '../../lib/urlstate.ts';

  const form = document.getElementById('calc') as HTMLFormElement;
  const results = document.getElementById('results')!;
  const $ = (id: string) => document.getElementById(id) as HTMLInputElement;

  function compute() {
    const salary = readNumber($('salary'), 0);
    const days = Math.max(1, readNumber($('days'), 1));
    const r = overtimePay({
      monthlySalary: salary,
      weekdayHours: readNumber($('weekday'), 0),
      restDayHours: readNumber($('rest'), 0),
      holidayHours: readNumber($('holiday'), 0),
    });
    if (salary <= 0) {
      results.innerHTML = '<p class="muted">請輸入月薪。</p>';
      return;
    }
    const section = (title: string, tiers: typeof r.weekday.tiers, total: number) =>
      tiers.length
        ? `<tr><th colspan="4" style="text-align:left;background:var(--surface-2)">${title}　小計 ${money(total)}</th></tr>` +
          tiers
            .map(
              (t) =>
                `<tr><td>${t.label}</td><td>${num(t.hours, 1)} 小時</td><td>${t.multiplier === 1 ? '—' : '×' + t.multiplier.toFixed(2)}</td><td>${money(t.pay)}</td></tr>`,
            )
            .join('')
        : '';

    results.innerHTML = `
      <div class="result-hero">
        <span class="label">單日加班費合計</span>
        <span class="value">${money(r.total)}</span>
        <span class="sub">時薪 ${num(r.hourlyWage, 2)} 元（月薪 ÷ 240）${days > 1 ? `；${days} 天估計 ${money(r.total * days)}` : ''}</span>
      </div>
      <div class="stats">
        <div class="stat"><div class="k">平日加班</div><div class="v">${money(r.weekday.total)}</div></div>
        <div class="stat"><div class="k">休息日出勤</div><div class="v">${money(r.restDay.total)}</div></div>
        <div class="stat"><div class="k">國定假日／特休出勤</div><div class="v">${money(r.holiday.total)}</div></div>
        <div class="stat"><div class="k">當月估計（×${days} 天）</div><div class="v">${money(r.total * days)}</div></div>
      </div>
      ${r.warnings.map((w) => `<div class="notice danger" style="margin-top:1rem">${w}</div>`).join('')}
      <details style="margin-top:1rem" open>
        <summary>計算明細</summary>
        <div class="table-wrap"><table>
          <thead><tr><th>時段</th><th>時數</th><th>倍率</th><th>金額</th></tr></thead>
          <tbody>
            ${section('平日延長工時', r.weekday.tiers, r.weekday.total)}
            ${section('休息日出勤', r.restDay.tiers, r.restDay.total)}
            ${section('國定假日／特休出勤', r.holiday.tiers, r.holiday.total)}
          </tbody>
        </table></div>
      </details>`;
  }

  bindCalculator(form, compute);
  setupShareButton(document.getElementById('share') as HTMLButtonElement);
</script>
