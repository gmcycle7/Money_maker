---
import '../styles/global.css';
import { SITE, MONETIZATION } from '../config/site.ts';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title: string;
  description: string;
  /** 頁面路徑，例：'/tools/mortgage' */
  path: string;
  type?: 'website' | 'article';
  /** 絕對或相對於站台根目錄的 OG 圖片 */
  image?: string;
  noindex?: boolean;
  /** 額外 JSON-LD 物件 */
  jsonLd?: Record<string, unknown>[];
  publishedTime?: string;
  modifiedTime?: string;
  /** true = 不在 title 後面加站名 */
  bareTitle?: boolean;
}

const {
  title,
  description,
  path,
  type = 'website',
  image = '/og.png',
  noindex = false,
  jsonLd = [],
  publishedTime,
  modifiedTime,
  bareTitle = false,
} = Astro.props;

const siteUrl = (Astro.site ?? new URL(SITE.url)).toString().replace(/\/$/, '');
const canonical = `${siteUrl}${path === '/' ? '' : path}`;
const ogImage = image.startsWith('http') ? image : `${siteUrl}${image}`;
const fullTitle = bareTitle ? title : `${title}｜${SITE.name} ${SITE.nameEn}`;

const { adsense, analytics } = MONETIZATION;
const adsenseSrc = adsense.client
  ? `https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=${adsense.client}`
  : '';

const baseLd: Record<string, unknown>[] = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    name: SITE.name,
    alternateName: SITE.nameEn,
    url: siteUrl,
    inLanguage: SITE.locale,
    description: SITE.description,
  },
  {
    '@context': 'https://schema.org',
    '@type': 'Organization',
    name: SITE.name,
    url: siteUrl,
    logo: `${siteUrl}/favicon.svg`,
    email: SITE.contactEmail,
  },
  ...jsonLd,
];
---

<!doctype html>
<html lang="zh-Hant-TW">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta name="theme-color" content="#0f7a5a" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#0f1613" media="(prefers-color-scheme: dark)" />

    <meta property="og:type" content={type} />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:locale" content="zh_TW" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    {publishedTime && <meta property="article:published_time" content={publishedTime} />}
    {modifiedTime && <meta property="article:modified_time" content={modifiedTime} />}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <script is:inline>
      // 先套用使用者選過的主題，避免閃爍
      try {
        var t = localStorage.getItem('theme');
        if (t === 'dark' || t === 'light') document.documentElement.setAttribute('data-theme', t);
      } catch (e) {}
    </script>

    {
      analytics.ga4Id && (
        <>
          <script is:inline async src={`https://www.googletagmanager.com/gtag/js?id=${analytics.ga4Id}`} />
          <script is:inline define:vars={{ id: analytics.ga4Id }}>
            window.dataLayer = window.dataLayer || [];
            function gtag() {
              dataLayer.push(arguments);
            }
            gtag('js', new Date());
            gtag('config', id, { anonymize_ip: true });
          </script>
        </>
      )
    }
    {adsenseSrc && <script is:inline async src={adsenseSrc} crossorigin="anonymous" />}

    {baseLd.map((ld) => <script type="application/ld+json" set:html={JSON.stringify(ld)} />)}
    <slot name="head" />
  </head>
  <body>
    <a class="skip-link" href="#main">跳到主要內容</a>
    <Header />
    <main id="main">
      <slot />
    </main>
    <Footer />
    {
      analytics.cloudflareToken && (
        <script
          is:inline
          defer
          src="https://static.cloudflareinsights.com/beacon.min.js"
          data-cf-beacon={JSON.stringify({ token: analytics.cloudflareToken })}
        />
      )
    }
    <script>
      // 聯盟連結點擊追蹤（有 GA4 時才會送事件）
      document.addEventListener('click', (e) => {
        const a = (e.target as HTMLElement).closest<HTMLAnchorElement>('a[data-affiliate]');
        if (!a) return;
        const w = window as unknown as { gtag?: (...args: unknown[]) => void };
        w.gtag?.('event', 'affiliate_click', {
          offer_id: a.dataset.affiliate,
          offer_category: a.dataset.category,
          page_path: location.pathname,
        });
      });
    </script>
  </body>
</html>
